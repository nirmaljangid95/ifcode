# LLM Configuration
LLM_PROVIDER=ollama  # ollama, openai, or custom
LLM_MODEL=llama3.2:3b
LLM_BASE_URL=http://localhost:11434  # Ollama default
LLM_API_KEY=  # Only needed for API providers

# Database Configuration
DATABASE_PATH=data/test_messy.db
DB_TIMEOUT=30
DB_MAX_ROWS=10000
DB_READ_ONLY=true

# Agent Configuration
MAX_RETRY_ATTEMPTS=2
ENABLE_VALIDATION=true
LOG_LEVEL=INFO

# Optional: OpenAI-compatible API
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=your-api-key-here
